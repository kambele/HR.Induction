@model PresenterProgrammeViewModel
@{
    ViewData["Title"] = "Programme attendance";
    var present = Model.Attendees.Count(x => x.Status == ProgrammeAttendanceStatus.Present);
    var absent = Model.Attendees.Count(x => x.Status == ProgrammeAttendanceStatus.Absent);
    var pending = Model.Attendees.Count(x => x.Status == ProgrammeAttendanceStatus.Pending);
    var attendeesWithEmail = Model.Attendees.Count(x =>
        x.Status == ProgrammeAttendanceStatus.Pending
        && !x.ConfirmedAtUtc.HasValue
        && !string.IsNullOrWhiteSpace(x.Induction.EmployeeEmail));
    var feedbackEligible = Model.Attendees.Count(x =>
        x.Status == ProgrammeAttendanceStatus.Present
        && !x.HasFeedback
        && !string.IsNullOrWhiteSpace(x.Induction.EmployeeEmail));
    var profileEligible = Model.Attendees.Count(x => !string.IsNullOrWhiteSpace(x.Induction.EmployeeEmail));
    var completedPresentations = Model.Programme.Sessions.Count(x => x.CompletedAtUtc.HasValue);
}

<section class="page-heading d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3">
    <div>
        <a class="back-link" asp-action="Index">&larr; Back to presenter workspace</a>
        <p class="eyebrow">Instructor and presenter attendance</p>
        <h1>@Model.Programme.Title</h1>
        <p class="lead-copy">@Model.Programme.ProgrammeDate.ToString("dddd, dd MMMM yyyy") · @(Model.Programme.Venue ?? "Venue to be confirmed")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanManageChecklist)
        {
            <form asp-controller="InductionProgrammes" asp-action="ApplyChecklistPhasesToAll" method="post">
                <input type="hidden" name="programmeId" value="@Model.Programme.Id" />
                <input type="hidden" name="returnToPresenter" value="true" />
                <button class="btn btn-outline-primary btn-lg" type="submit" disabled="@(Model.Attendees.Count == 0 ? "disabled" : null)">Update all employee checklists</button>
            </form>
        }
        <button class="btn btn-primary btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#attendanceInviteModal" disabled="@(!Model.CanSendAttendanceInvitations || attendeesWithEmail == 0 ? "disabled" : null)">Invite employees</button>
        @if (Model.CanManageChecklist && Model.FeedbackRequired)
        {
            <button class="btn btn-success btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#feedbackInviteModal" disabled="@(!Model.CanSendFeedbackInvitations || feedbackEligible == 0 ? "disabled" : null)">Send feedback links</button>
        }
        @if (Model.CanManageChecklist && Model.ProgrammeCompleted)
        {
            <button class="btn btn-outline-primary btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#profileInviteModal" disabled="@(profileEligible == 0 ? "disabled" : null)">Send review &amp; sign-off links</button>
        }
    </div>
</section>

@if (Model.ProgrammeCompleted && Model.FeedbackRequired)
{
    <div class="alert alert-success d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <span><strong>Programme completed.</strong> HRBP can now invite present employees to complete feedback and evaluation.</span>
        <span>@feedbackEligible eligible employee@(feedbackEligible == 1 ? string.Empty : "s")</span>
    </div>
}
else if (Model.ProgrammeCompleted)
{
    <div class="alert alert-success"><strong>Programme completed.</strong> Employee feedback and evaluation are not required for this programme.</div>
}
else if (Model.CanSendAttendanceInvitations)
{
    <div class="alert alert-info"><strong>Pre-programme invitation is open.</strong> Employees receive the date, venue, full presentation schedule, attendance link and attendance guide. Invitations close at @Model.ProgrammeStartsAt.ToString("dd MMM yyyy HH:mm").</div>
}
else
{
    <div class="alert alert-warning"><strong>Attendance invitations are closed.</strong> @(Model.FeedbackRequired ? "Mark all presentations complete to enable HRBP feedback invitations." : "Mark all presentations complete to close the programme. Employee feedback is not required.")</div>
}

<section class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-label">Attendees</span><strong>@Model.Attendees.Count</strong><span class="metric-note">Assigned employees</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card metric-success"><span class="metric-label">Present</span><strong>@present</strong><span class="metric-note">Confirmed attendance</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card metric-danger"><span class="metric-label">Absent</span><strong>@absent</strong><span class="metric-note">Confirmed absence</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card metric-gold"><span class="metric-label">Pending</span><strong>@pending</strong><span class="metric-note">Awaiting response</span></div></div>
</section>

<div class="row g-4">
    <section class="col-xl-8">
        <div class="content-card p-0 overflow-hidden">
            <div class="card-heading p-4 mb-0"><div><h2>Attendee register</h2><p>Employees can self-confirm from the emailed link, or a presenter can update the register here.</p></div></div>
            @if (Model.Attendees.Count == 0)
            {
                <div class="empty-state py-5">No employees are assigned to this programme. Assign employees by editing their induction records.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table attendance-table align-middle mb-0">
                        <thead><tr><th>Employee</th><th>Attendance</th><th>Confirmation</th><th class="text-end">Update</th></tr></thead>
                        <tbody>
                        @foreach (var attendee in Model.Attendees)
                        {
                            <tr>
                                <td><strong>@attendee.Induction.EmployeeName</strong><span class="subtext">@attendee.Induction.Position</span><span class="subtext">@(attendee.Induction.EmployeeEmail ?? "Email not recorded")</span></td>
                                <td><span class="attendance-pill attendance-@attendee.Status.ToString().ToLowerInvariant()">@attendee.Status</span></td>
                                <td>
                                    @if (attendee.ConfirmedAtUtc.HasValue)
                                    {
                                        <span>@attendee.ConfirmationSource</span><span class="subtext">@attendee.ConfirmedBy</span><span class="subtext">@attendee.ConfirmedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                    }
                                    else if (attendee.InvitationSentAtUtc.HasValue)
                                    {
                                        <span>Link sent</span><span class="subtext">@attendee.InvitationSentAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not yet confirmed</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="UpdateAttendance" method="post"><input type="hidden" name="ProgrammeId" value="@Model.Programme.Id" /><input type="hidden" name="InductionCaseId" value="@attendee.Induction.Id" /><input type="hidden" name="Status" value="Present" /><button class="btn btn-sm @(attendee.Status == ProgrammeAttendanceStatus.Present ? "btn-success" : "btn-outline-success")" type="submit">Present</button></form>
                                        <form asp-action="UpdateAttendance" method="post"><input type="hidden" name="ProgrammeId" value="@Model.Programme.Id" /><input type="hidden" name="InductionCaseId" value="@attendee.Induction.Id" /><input type="hidden" name="Status" value="Absent" /><button class="btn btn-sm @(attendee.Status == ProgrammeAttendanceStatus.Absent ? "btn-danger" : "btn-outline-danger")" type="submit">Absent</button></form>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    <aside class="col-xl-4">
        <div class="content-card">
            <div class="card-heading"><div><h2>Programme schedule</h2><p>@completedPresentations of @Model.Programme.Sessions.Count presentations complete.</p></div></div>
            <div class="programme-agenda-list">
                @foreach (var session in Model.Programme.Sessions.OrderBy(x => x.SortOrder))
                {
                    <div class="programme-agenda-item">
                        <time>@session.StartTime.ToString("hh\\:mm")-@session.EndTime.ToString("hh\\:mm")</time>
                        <span><strong>@session.Division</strong><small>@session.PresenterName</small><code>@session.PresenterUsername</code><small>@(session.RequiresFeedback ? "Employee feedback required" : "Employee feedback not required")</small></span>
                        <div class="programme-session-completion">
                            @if (session.CompletedAtUtc.HasValue)
                            {
                                <span class="admin-status is-active">Complete</span>
                                <small>@session.CompletedBy<br />@session.CompletedAtUtc.Value.ToLocalTime().ToString("dd MMM HH:mm")</small>
                            }
                            else
                            {
                                <span class="admin-status is-inactive">Not complete</span>
                            }
                            @if (Model.CanManageChecklist)
                            {
                                <form asp-action="UpdatePresentationCompletion" method="post">
                                    <input type="hidden" name="ProgrammeId" value="@Model.Programme.Id" />
                                    <input type="hidden" name="SessionId" value="@session.Id" />
                                    <input type="hidden" name="IsCompleted" value="@(!session.CompletedAtUtc.HasValue ? "true" : "false")" />
                                    <button class="btn btn-sm @(session.CompletedAtUtc.HasValue ? "btn-outline-secondary" : "btn-outline-success")" type="submit">@(session.CompletedAtUtc.HasValue ? "Reopen" : "Mark complete")</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </aside>
</div>

@if (Model.CanManageChecklist)
{
    <section class="content-card mt-4 programme-global-checklist">
        <div class="card-heading">
            <div>
                <p class="eyebrow mb-1">HRBP controls</p>
                <h2>Global checklist maintenance</h2>
                <p>Update an activity once and apply the same status and notes to every employee assigned to this programme.</p>
            </div>
            <form asp-controller="InductionProgrammes" asp-action="ApplyChecklistPhasesToAll" method="post">
                <input type="hidden" name="programmeId" value="@Model.Programme.Id" />
                <input type="hidden" name="returnToPresenter" value="true" />
                <button class="btn btn-outline-primary" type="submit" disabled="@(Model.Attendees.Count == 0 ? "disabled" : null)">Refresh all from programme phases</button>
            </form>
        </div>
        @if (Model.LockChecklistWhenSignOffStarts)
        {
            <div class="alert alert-info">Employee records whose sign-off has started remain protected and will be skipped.</div>
        }
        @if (Model.ChecklistItems.Count == 0)
        {
            <div class="empty-state">No active checklist activities are available for the selected programme phases.</div>
        }
        else
        {
            <div class="programme-global-phase-stack">
                @foreach (var phaseGroup in Model.ChecklistItems.OrderBy(x => x.SortOrder).GroupBy(x => x.Phase))
                {
                    <section class="programme-global-phase">
                        <div class="programme-global-phase-heading">
                            <h3>@DisplayText.For(phaseGroup.Key)</h3>
                            <span>@phaseGroup.Count() activities</span>
                        </div>
                        <div class="programme-global-task-list">
                            @foreach (var item in phaseGroup)
                            {
                                var notStarted = item.EmployeeTaskCount - item.CompletedCount - item.NotApplicableCount;
                                <article class="programme-global-task">
                                    <div class="programme-global-task-summary">
                                        <div>
                                            <strong>@item.Title</strong>
                                            <span>@item.Section · @item.ResponsibleRole</span>
                                            <small>@item.EmployeeTaskCount of @item.ParticipantCount employee checklists synced</small>
                                        </div>
                                        <div class="programme-global-task-counts">
                                            <span class="task-status task-status-completed">@item.CompletedCount complete</span>
                                            <span class="task-status task-status-notstarted">@notStarted not started</span>
                                            @if (item.NotApplicableCount > 0)
                                            {
                                                <span class="task-status task-status-notapplicable">@item.NotApplicableCount N/A</span>
                                            }
                                        </div>
                                    </div>
                                    <details class="programme-global-task-editor">
                                        <summary class="btn btn-sm btn-outline-secondary">Update for all employees</summary>
                                        <form asp-action="UpdateProgrammeChecklistItem" method="post" class="programme-global-task-form">
                                            <input type="hidden" name="ProgrammeId" value="@Model.Programme.Id" />
                                            <input type="hidden" name="ChecklistTemplateItemId" value="@item.ChecklistTemplateItemId" />
                                            <div>
                                                <label class="form-label" for="global-status-@item.ChecklistTemplateItemId">Status</label>
                                                <select class="form-select" id="global-status-@item.ChecklistTemplateItemId" name="Status" required>
                                                    <option value="">Select status</option>
                                                    @foreach (var status in Enum.GetValues<InductionTaskStatus>())
                                                    {
                                                        <option value="@status">@DisplayText.For(status)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div>
                                                <label class="form-label" for="global-notes-@item.ChecklistTemplateItemId">Notes</label>
                                                <textarea class="form-control" id="global-notes-@item.ChecklistTemplateItemId" name="Notes" rows="2" placeholder="Blank clears the notes for this activity"></textarea>
                                            </div>
                                            <div>
                                                <label class="form-label" for="global-assignee-@item.ChecklistTemplateItemId">Assigned Windows username</label>
                                                <input class="form-control" id="global-assignee-@item.ChecklistTemplateItemId" name="AssignedToUsername" placeholder="Optional: DOMAIN\username" />
                                                <div class="form-text">Leave blank to keep each employee's current assignment.</div>
                                            </div>
                                            <div>
                                                <label class="form-label" for="global-due-@item.ChecklistTemplateItemId">Due date</label>
                                                <input class="form-control" id="global-due-@item.ChecklistTemplateItemId" name="DueDate" type="date" />
                                                <div class="form-text">Leave blank to keep each employee's current due date.</div>
                                            </div>
                                            <button class="btn btn-primary align-self-end" type="submit" disabled="@(Model.Attendees.Count == 0 ? "disabled" : null)">Apply to all employees</button>
                                        </form>
                                    </details>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </section>
}

<div class="modal fade" id="attendanceInviteModal" tabindex="-1" aria-labelledby="attendanceInviteTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content invitation-modal attendance-invitation-modal" asp-action="SendAttendanceInvitations" method="post">
                <input type="hidden" name="ProgrammeId" value="@Model.Programme.Id" />
                <div class="modal-header">
                    <div><p class="eyebrow mb-1">Pre-programme invitation</p><h2 class="modal-title fs-4" id="attendanceInviteTitle">Invite employees to confirm attendance</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!Model.SmtpConfigured)
                    {
                        <div class="alert alert-warning"><strong>Email delivery is not ready.</strong> @Model.SmtpSummary</div>
                    }
                    <div class="invitation-email-summary mb-3">
                        <strong>Email includes programme schedule</strong>
                        <span>@Model.Programme.ProgrammeDate.ToString("dddd, dd MMMM yyyy") · @(Model.Programme.Venue ?? "Venue to be confirmed")</span>
                        <div class="invitation-schedule-list">
                            @foreach (var session in Model.Programme.Sessions.OrderBy(x => x.SortOrder))
                            {
                                <div><time>@session.StartTime.ToString("hh\\:mm")-@session.EndTime.ToString("hh\\:mm")</time><span><strong>@session.Division</strong><small>@session.PresenterName</small></span></div>
                            }
                        </div>
                        <small>The email contains a reusable programme link with a one-time attendance response and attaches the employee attendance guide.</small>
                    </div>
                    <div class="invitation-selection-toolbar">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="selectAllAttendance" disabled="@(attendeesWithEmail == 0 ? "disabled" : null)" /><label class="form-check-label" for="selectAllAttendance">Select all attendees with email</label></div>
                        <span id="attendanceSelectedCount">0 selected</span>
                    </div>
                    <div class="invitation-list">
                        @foreach (var attendee in Model.Attendees)
                        {
                            var hasEmail = !string.IsNullOrWhiteSpace(attendee.Induction.EmployeeEmail);
                            var eligible = hasEmail && attendee.Status == ProgrammeAttendanceStatus.Pending && !attendee.ConfirmedAtUtc.HasValue;
                            <label class="invitation-choice @(eligible ? string.Empty : "is-unavailable")" for="attendance-invite-@attendee.Induction.Id">
                                <input class="form-check-input attendance-invite-checkbox" type="checkbox" name="InductionCaseIds" value="@attendee.Induction.Id" id="attendance-invite-@attendee.Induction.Id" disabled="@(eligible ? null : "disabled")" />
                                <span class="invitation-choice-copy"><strong>@attendee.Induction.EmployeeName</strong><span>@(hasEmail ? attendee.Induction.EmployeeEmail : "Email address not recorded")</span></span>
                                <span class="invitation-choice-status">@(attendee.InvitationSentAtUtc.HasValue ? $"Last sent {attendee.InvitationSentAtUtc.Value.ToLocalTime():dd MMM yyyy HH:mm}" : attendee.Status.ToString())</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="sendAttendanceInvitations" type="submit" data-smtp-ready="@Model.SmtpConfigured.ToString().ToLowerInvariant()" disabled>Send invitations</button></div>
        </form>
    </div>
</div>

@if (Model.CanManageChecklist && Model.FeedbackRequired)
{
    <div class="modal fade" id="feedbackInviteModal" tabindex="-1" aria-labelledby="feedbackInviteTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content invitation-modal attendance-invitation-modal" asp-action="SendFeedbackInvitations" method="post">
                <input type="hidden" name="ProgrammeId" value="@Model.Programme.Id" />
                <div class="modal-header">
                    <div><p class="eyebrow mb-1">Post-programme evaluation</p><h2 class="modal-title fs-4" id="feedbackInviteTitle">Send feedback and evaluation links</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!Model.SmtpConfigured)
                    {
                        <div class="alert alert-warning"><strong>Email delivery is not ready.</strong> @Model.SmtpSummary</div>
                    }
                    <div class="invitation-email-summary mb-3">
                        <strong>Available after programme completion</strong>
                        <span>The secure one-time link opens a standalone employee feedback form.</span>
                        <small>The email attaches the feedback guide. Only present employees without an existing response can be selected, and each link stops working after submission.</small>
                    </div>
                    <div class="invitation-selection-toolbar">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="selectAllFeedback" disabled="@(feedbackEligible == 0 ? "disabled" : null)" /><label class="form-check-label" for="selectAllFeedback">Select all eligible employees</label></div>
                        <span id="feedbackSelectedCount">0 selected</span>
                    </div>
                    <div class="invitation-list">
                        @foreach (var attendee in Model.Attendees)
                        {
                            var hasEmail = !string.IsNullOrWhiteSpace(attendee.Induction.EmployeeEmail);
                            var eligible = hasEmail && attendee.Status == ProgrammeAttendanceStatus.Present && !attendee.HasFeedback;
                            var feedbackStatus = attendee.HasFeedback
                                ? "Feedback submitted"
                                : !hasEmail
                                    ? "Email not recorded"
                                    : attendee.Status != ProgrammeAttendanceStatus.Present
                                        ? $"Attendance {attendee.Status}"
                                        : attendee.FeedbackInvitationSentAtUtc.HasValue
                                            ? $"Last sent {attendee.FeedbackInvitationSentAtUtc.Value.ToLocalTime():dd MMM yyyy HH:mm}"
                                            : "Ready";
                            <label class="invitation-choice @(eligible ? string.Empty : "is-unavailable")" for="feedback-invite-@attendee.Induction.Id">
                                <input class="form-check-input feedback-invite-checkbox" type="checkbox" name="InductionCaseIds" value="@attendee.Induction.Id" id="feedback-invite-@attendee.Induction.Id" disabled="@(eligible ? null : "disabled")" />
                                <span class="invitation-choice-copy"><strong>@attendee.Induction.EmployeeName</strong><span>@(hasEmail ? attendee.Induction.EmployeeEmail : "Email address not recorded")</span></span>
                                <span class="invitation-choice-status">@feedbackStatus</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success" id="sendFeedbackInvitations" type="submit" data-smtp-ready="@Model.SmtpConfigured.ToString().ToLowerInvariant()" disabled>Send feedback links</button></div>
            </form>
        </div>
    </div>
}

@if (Model.CanManageChecklist && Model.ProgrammeCompleted)
{
    <div class="modal fade" id="profileInviteModal" tabindex="-1" aria-labelledby="profileInviteTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <form class="modal-content invitation-modal attendance-invitation-modal" asp-action="SendProfileInvitations" method="post">
                <input type="hidden" name="ProgrammeId" value="@Model.Programme.Id" />
                <div class="modal-header">
                    <div><p class="eyebrow mb-1">Employee induction completion</p><h2 class="modal-title fs-4" id="profileInviteTitle">Send induction review and sign-off links</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!Model.SmtpConfigured)
                    {
                        <div class="alert alert-warning"><strong>Email delivery is not ready.</strong> @Model.SmtpSummary</div>
                    }
                    <div class="invitation-email-summary mb-3">
                        <strong>Programme completed</strong>
                        <span>Employees receive a secure link to their induction profile.</span>
                        <small>The email instructs each employee to review their induction record, complete any outstanding requirements and submit employee sign-off.</small>
                    </div>
                    <div class="invitation-selection-toolbar">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="selectAllProfiles" disabled="@(profileEligible == 0 ? "disabled" : null)" /><label class="form-check-label" for="selectAllProfiles">Select all employees with email</label></div>
                        <span id="profileSelectedCount">0 selected</span>
                    </div>
                    <div class="invitation-list">
                        @foreach (var attendee in Model.Attendees)
                        {
                            var hasEmail = !string.IsNullOrWhiteSpace(attendee.Induction.EmployeeEmail);
                            var profileStatus = !hasEmail
                                ? "Email not recorded"
                                : attendee.ProfileInvitationSentAtUtc.HasValue
                                    ? $"Last sent {attendee.ProfileInvitationSentAtUtc.Value.ToLocalTime():dd MMM yyyy HH:mm}"
                                    : "Ready";
                            <label class="invitation-choice @(hasEmail ? string.Empty : "is-unavailable")" for="profile-invite-@attendee.Induction.Id">
                                <input class="form-check-input profile-invite-checkbox" type="checkbox" name="InductionCaseIds" value="@attendee.Induction.Id" id="profile-invite-@attendee.Induction.Id" disabled="@(hasEmail ? null : "disabled")" />
                                <span class="invitation-choice-copy"><strong>@attendee.Induction.EmployeeName</strong><span>@(hasEmail ? attendee.Induction.EmployeeEmail : "Email address not recorded")</span></span>
                                <span class="invitation-choice-status">@profileStatus</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="sendProfileInvitations" type="submit" data-smtp-ready="@Model.SmtpConfigured.ToString().ToLowerInvariant()" disabled>Send review links</button></div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const initialiseInvitations = (checkboxSelector, selectAllId, countId, sendId, noun) => {
                const checkboxes = [...document.querySelectorAll(`${checkboxSelector}:not(:disabled)`)];
                const selectAll = document.getElementById(selectAllId);
                const count = document.getElementById(countId);
                const send = document.getElementById(sendId);
                if (!selectAll || !count || !send) return;
                const smtpReady = send.dataset.smtpReady === 'true';
                const refresh = () => {
                    const selected = checkboxes.filter(item => item.checked).length;
                    count.textContent = `${selected} selected`;
                    send.disabled = !smtpReady || selected === 0;
                    send.textContent = selected === 0 ? `Send ${noun}` : `Send ${selected} ${noun}${selected === 1 ? '' : 's'}`;
                    selectAll.checked = checkboxes.length > 0 && selected === checkboxes.length;
                    selectAll.indeterminate = selected > 0 && selected < checkboxes.length;
                };
                selectAll.addEventListener('change', () => { checkboxes.forEach(item => item.checked = selectAll.checked); refresh(); });
                checkboxes.forEach(item => item.addEventListener('change', refresh));
                refresh();
            };

            initialiseInvitations('.attendance-invite-checkbox', 'selectAllAttendance', 'attendanceSelectedCount', 'sendAttendanceInvitations', 'invitation');
            initialiseInvitations('.feedback-invite-checkbox', 'selectAllFeedback', 'feedbackSelectedCount', 'sendFeedbackInvitations', 'feedback link');
            initialiseInvitations('.profile-invite-checkbox', 'selectAllProfiles', 'profileSelectedCount', 'sendProfileInvitations', 'review link');
        })();
    </script>
}
