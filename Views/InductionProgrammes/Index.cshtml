@model IReadOnlyList<InductionProgramme>
@{
    ViewData["Title"] = "Induction programmes";
}

<section class="page-heading d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3">
    <div><p class="eyebrow">HR business partner</p><h1>Corporate induction programmes</h1><p class="lead-copy">Build the divisional schedule, assign employees and review programme feedback.</p></div>
    <a class="btn btn-primary btn-lg" asp-action="Create">Create programme</a>
</section>

<div class="content-card p-0 overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="empty-state py-5">No corporate induction programmes have been created.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0 programme-list-table">
                <thead><tr><th>Programme</th><th>Presentations</th><th>Employees</th><th>Feedback</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var programme in Model)
                {
                    var responses = programme.Participants.Count(x => x.EmployeeFeedback?.OverallProgrammeRating is not null);
                    var feedbackRequired = Namfisa.Induction.Services.InductionProgrammeRules.RequiresFeedback(programme);
                    <tr>
                        <td><strong>@programme.Title</strong><span class="subtext">@programme.ProgrammeDate.ToString("dddd, dd MMMM yyyy") · @(programme.Venue ?? "Venue to be confirmed")</span></td>
                        <td>@programme.Sessions.Count</td><td>@programme.Participants.Count</td><td>@(feedbackRequired ? $"{responses} / {programme.Participants.Count}" : "Not required")</td>
                        <td><span class="programme-status programme-status-@programme.Status.ToString().ToLowerInvariant()">@programme.Status</span></td>
                        <td class="text-end"><div class="btn-group btn-group-sm"><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@programme.Id">Open</a><a class="btn btn-outline-primary" asp-action="Report" asp-route-id="@programme.Id">Report</a></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
