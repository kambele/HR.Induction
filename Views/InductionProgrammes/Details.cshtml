@model InductionProgrammeDetailsViewModel
@{
    var programme = Model.Programme;
    ViewData["Title"] = programme.Title;
    var responses = programme.Participants.Count(x => x.EmployeeFeedback?.OverallProgrammeRating is not null);
    var checklistPhases = programme.ChecklistPhases.Count == 0
        ? Enum.GetValues<InductionPhase>()
        : programme.ChecklistPhases.Select(x => x.Phase).OrderBy(x => x).ToArray();
    var assignableEmployees = Model.AvailableEmployees.Count(x => x.CanAssign);
    var refreshableEmployees = Model.AssignedEmployees.Count(x => x.CanApplyPhases);
    var programmeCompleted = Namfisa.Induction.Services.InductionProgrammeRules.IsCompleted(programme);
    var feedbackRequired = Namfisa.Induction.Services.InductionProgrammeRules.RequiresFeedback(programme);
    var canInviteEmployees = Namfisa.Induction.Services.InductionProgrammeRules.CanSendAttendanceInvitations(programme, DateTime.Now);
}

<section class="page-heading d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3">
    <div>
        <a class="back-link" asp-action="Index">&larr; Back to programmes</a>
        <p class="eyebrow">Corporate induction programme</p>
        <h1>@programme.Title</h1>
        <p class="lead-copy">@programme.ProgrammeDate.ToString("dddd, dd MMMM yyyy") · @(programme.Venue ?? "Venue to be confirmed")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <span class="programme-status programme-status-@programme.Status.ToString().ToLowerInvariant()">@programme.Status</span>
        <a class="btn btn-outline-primary" asp-controller="Presenters" asp-action="Programme" asp-route-id="@programme.Id">@(programmeCompleted && feedbackRequired ? "Send feedback links" : canInviteEmployees ? "Invite employees" : "Attendance and programme")</a>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@programme.Id">Edit programme</a>
        <a class="btn btn-primary" asp-action="Report" asp-route-id="@programme.Id">View report</a>
    </div>
</section>

<section class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-label">Presentations</span><strong>@programme.Sessions.Count</strong><span class="metric-note">Scheduled divisions</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card metric-gold"><span class="metric-label">Employees</span><strong>@Model.AssignedEmployees.Count</strong><span class="metric-note">Assigned records</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card metric-success"><span class="metric-label">Responses</span><strong>@(feedbackRequired ? responses.ToString() : "N/A")</strong><span class="metric-note">@(feedbackRequired ? "Programme evaluations" : "Feedback not required")</span></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card"><span class="metric-label">Response rate</span><strong>@(feedbackRequired ? $"{(Model.AssignedEmployees.Count == 0 ? 0 : Math.Round(responses * 100d / Model.AssignedEmployees.Count))}%" : "N/A")</strong><span class="metric-note">@(feedbackRequired ? "Of assigned employees" : "Evaluation not required")</span></div></div>
</section>

<section class="content-card programme-phase-summary mb-4">
    <div>
        <p class="eyebrow mb-1">Employee checklist</p>
        <h2>Applicable phases</h2>
        <p>These phases can be applied to every employee induction assigned to this programme.</p>
    </div>
    <div class="programme-phase-badges">
        @foreach (var phase in checklistPhases)
        {
            <span>@DisplayText.For(phase)</span>
        }
    </div>
</section>

<div class="row g-4 mb-4">
    <section class="col-xl-7">
        <div class="content-card p-0 overflow-hidden h-100">
            <div class="card-heading p-4 mb-0"><div><h2>Programme schedule</h2><p>Divisional presenters and time slots.</p></div></div>
            <div class="table-responsive">
                <table class="table programme-schedule-table mb-0">
                    <thead><tr><th>Time</th><th>Division</th><th>Presenter</th><th>Feedback</th></tr></thead>
                    <tbody>
                    @foreach (var session in programme.Sessions.OrderBy(x => x.SortOrder))
                    {
                        <tr>
                            <td><strong>@session.StartTime.ToString("hh\\:mm")-@session.EndTime.ToString("hh\\:mm")</strong></td>
                            <td>@session.Division</td>
                            <td>@session.PresenterName<span class="subtext">@session.PresenterUsername</span></td>
                            <td><span class="admin-status @(session.RequiresFeedback ? "is-active" : "is-inactive")">@(session.RequiresFeedback ? "Required" : "Not required")</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="col-xl-5">
        <form class="content-card h-100" asp-action="ApplyChecklistPhasesToAll" method="post">
            <input type="hidden" name="programmeId" value="@programme.Id" />
            <div class="card-heading">
                <div>
                    <h2>Assigned employees</h2>
                    <p>Review participants, then update every available checklist in one action.</p>
                </div>
            </div>

            @if (Model.AssignedEmployees.Count == 0)
            {
                <div class="empty-state">No employees are assigned. Add employee inductions below.</div>
            }
            else
            {
                <div class="programme-employee-list">
                    @foreach (var employee in Model.AssignedEmployees)
                    {
                        <div class="programme-employee-row programme-employee-row-static @(!employee.CanApplyPhases ? "is-protected" : string.Empty)">
                            <div class="programme-employee-copy">
                                <strong>@employee.EmployeeName</strong>
                                <span>@employee.Department · @employee.Division</span>
                                <small>@employee.ApplicableTaskCount applicable of @employee.TotalTaskCount checklist tasks</small>
                            </div>
                            <div class="programme-employee-action">
                                @if (!employee.CanApplyPhases)
                                {
                                    <span class="text-warning">@(employee.ProtectionReason ?? "Protected")</span>
                                }
                                else if (employee.HasFeedback)
                                {
                                    <span class="text-success">Feedback submitted</span>
                                }
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Inductions" asp-action="Details" asp-route-id="@(employee.AccessToken.ToString("N"))">Open</a>
                            </div>
                        </div>
                    }
                </div>
                <div class="programme-selection-footer">
                    <p>This keeps completed task results and adds, restores or excludes tasks to match the selected phases. Signed records remain protected.</p>
                    <button class="btn btn-primary" type="submit" disabled="@(refreshableEmployees == 0 ? "disabled" : null)">Update all employee checklists</button>
                </div>
            }
        </form>
    </section>
</div>

<section class="content-card p-0 overflow-hidden">
    <div class="card-heading p-4 mb-0 programme-employee-heading">
        <div>
            <p class="eyebrow mb-1">Programme participants</p>
            <h2>Add employee inductions</h2>
            <p>Tick employee records to assign or move them to this programme. Their checklist changes only when you apply the programme phases.</p>
        </div>
        <span class="programme-status">@Model.AvailableEmployees.Count available</span>
    </div>

    @if (Model.AvailableEmployees.Count == 0)
    {
        <div class="empty-state m-4">All employee induction records are already assigned to this programme.</div>
    }
    else
    {
        <form asp-action="AssignEmployees" method="post" id="assignProgrammeEmployeesForm">
            <input type="hidden" name="ProgrammeId" value="@programme.Id" />
            <div class="programme-assignment-toolbar">
                <div class="form-check mb-0">
                    <input class="form-check-input" id="selectAllAssignableEmployees" type="checkbox" disabled="@(assignableEmployees == 0 ? "disabled" : null)" />
                    <label class="form-check-label" for="selectAllAssignableEmployees">Select all available employees</label>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span id="assignProgrammeSelectedCount">0 selected</span>
                    <button class="btn btn-primary" id="assignProgrammeEmployees" type="submit" disabled>Add selected to programme</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 admin-table programme-employee-table">
                    <thead>
                        <tr>
                            <th class="employee-record-check"></th>
                            <th>Employee</th>
                            <th>Organisation</th>
                            <th>Current programme</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var employee in Model.AvailableEmployees)
                    {
                        <tr class="@(!employee.CanAssign ? "programme-protected-row" : string.Empty)">
                            <td class="employee-record-check">
                                <input class="form-check-input programme-assignment-checkbox" type="checkbox" name="InductionCaseIds" value="@employee.Id" id="programme-assignment-@employee.Id" disabled="@(!employee.CanAssign ? "disabled" : null)" />
                            </td>
                            <td>
                                <label for="programme-assignment-@employee.Id"><strong>@employee.EmployeeName</strong></label>
                                <span class="subtext">@employee.EmployeeUsername</span>
                            </td>
                            <td><strong>@employee.Department</strong><span class="subtext">@employee.Division</span></td>
                            <td>
                                <strong>@(employee.CurrentProgrammeTitle ?? "Not assigned")</strong>
                                @if (!employee.CanAssign)
                                {
                                    <span class="subtext text-warning">@employee.ProtectionReason</span>
                                }
                            </td>
                            <td><span class="status-badge status-@employee.Status.ToString().ToLowerInvariant()">@DisplayText.For(employee.Status)</span></td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-controller="Inductions" asp-action="Details" asp-route-id="@(employee.AccessToken.ToString("N"))">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </form>
    }
</section>

@section Scripts {
    <script>
        (() => {
            const initialiseSelection = (checkboxSelector, selectAllId, countId, buttonId) => {
                const checkboxes = [...document.querySelectorAll(checkboxSelector)].filter(item => !item.disabled);
                const selectAll = document.getElementById(selectAllId);
                const selectedCount = document.getElementById(countId);
                const submitButton = document.getElementById(buttonId);
                if (!selectAll || !selectedCount || !submitButton) return;

                const refresh = () => {
                    const selected = checkboxes.filter(item => item.checked).length;
                    selectedCount.textContent = `${selected} selected`;
                    submitButton.disabled = selected === 0;
                    selectAll.checked = checkboxes.length > 0 && selected === checkboxes.length;
                    selectAll.indeterminate = selected > 0 && selected < checkboxes.length;
                };

                selectAll.addEventListener('change', () => {
                    checkboxes.forEach(item => item.checked = selectAll.checked);
                    refresh();
                });
                checkboxes.forEach(item => item.addEventListener('change', refresh));
                refresh();
            };

            initialiseSelection('.programme-assignment-checkbox', 'selectAllAssignableEmployees', 'assignProgrammeSelectedCount', 'assignProgrammeEmployees');
        })();
    </script>
}
