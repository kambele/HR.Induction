<!DOCTYPE html>
@inject Namfisa.Induction.Services.IUserAccessService AccessService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isHr = AccessService.IsHr(User);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NAMFISA Induction</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/limitless-light.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Namfisa.Induction.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="limitless-light">
    <div class="limitless-shell">
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarTitle">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index" id="appSidebarTitle">
                    <img src="~/images/namfisa-logo.png" alt="NAMFISA" class="brand-logo" />
                    <span><strong>Employee Induction</strong><small>HR workspace</small></span>
                </a>
                <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close navigation"></button>
            </div>

            <div class="sidebar-profile">
                <span class="profile-avatar">@((User.Identity?.Name?.Split('\\').LastOrDefault()?.FirstOrDefault() ?? 'U').ToString().ToUpperInvariant())</span>
                <span><strong>@(User.Identity?.Name?.Split('\\').LastOrDefault() ?? "User")</strong><small>@(isHr ? "HR Business Partner" : "Authenticated user")</small></span>
                <span class="profile-online" title="Signed in"></span>
            </div>

            <nav class="sidebar-navigation" aria-label="Primary navigation">
                <span class="sidebar-section-title">Main</span>
                <a class="@(currentController == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index"><span class="nav-symbol">⌂</span><span>Dashboard</span></a>
                <a class="@(currentController == "Inductions" && currentAction != "Create" ? "active" : null)" asp-controller="Inductions" asp-action="Index"><span class="nav-symbol">▣</span><span>Employee inductions</span></a>
                <a class="@(currentController is "Presenters" or "Attendance" ? "active" : null)" asp-controller="Presenters" asp-action="Index"><span class="nav-symbol">✓</span><span>Presenter workspace</span></a>

                @if (isHr)
                {
                    <span class="sidebar-section-title">Planning</span>
                    <a class="@(currentController == "Inductions" && currentAction == "Create" ? "active" : null)" asp-controller="Inductions" asp-action="Create"><span class="nav-symbol">＋</span><span>New induction</span></a>
                    <a class="@(currentController == "InductionProgrammes" ? "active" : null)" asp-controller="InductionProgrammes" asp-action="Index"><span class="nav-symbol">◷</span><span>Induction programmes</span></a>
                    <a class="@(currentController == "Admin" ? "active" : null)" asp-controller="Admin" asp-action="Index"><span class="nav-symbol">⚙</span><span>Administration</span></a>
                }
            </nav>

            <div class="sidebar-footer">
                <span class="sidebar-footer-mark">N</span>
                <span><strong>NAMFISA</strong><small>Employee Services</small></span>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation">☰</button>
                    <div class="topbar-title"><span>Employee Services</span><strong>@ViewData["Title"]</strong></div>
                </div>
                <div class="topbar-right">
                    <a class="topbar-action" asp-controller="Inductions" asp-action="Index" title="Search induction records">⌕</a>
                    <span class="topbar-divider"></span>
                    <div class="topbar-user"><span class="user-dot" aria-hidden="true"></span><span>@User.Identity?.Name</span></div>
                </div>
            </header>

            <div class="app-content">
                <div class="container-fluid px-0">
                    @if (TempData["Success"] is string success)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @success
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Warning"] is string warning)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            @warning
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>

            <footer class="app-footer">
                <span>&copy; 2026 NAMFISA Employee Induction</span>
                <span>Secure Windows-authenticated workspace</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
