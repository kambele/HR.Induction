@model ChecklistTemplateListViewModel
@{
    ViewData["Title"] = "Checklist activities";
}

<section class="page-heading compact-heading">
    <a class="back-link" asp-action="Index">&larr; Back to administration</a>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">
        <div><p class="eyebrow">Administration</p><h1>Checklist activities</h1><p class="lead-copy">These templates are copied into each new induction plan, preserving that plan even when the template changes later.</p></div>
        <a class="btn btn-primary" asp-action="CreateChecklistTemplate">Add checklist activity</a>
    </div>
</section>

<form method="get" class="content-card admin-filter-bar mb-4">
    <div><label class="form-label" for="phase">Phase</label><select class="form-select" id="phase" name="phase"><option value="">All phases</option>@foreach (var phase in Enum.GetValues<InductionPhase>()) { <option value="@phase" selected="@(Model.Phase == phase ? "selected" : null)">@DisplayText.For(phase)</option> }</select></div>
    <div><label class="form-label" for="search">Search</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Activity, section or role" /></div>
    <div class="form-check form-switch align-self-center mt-4"><input class="form-check-input" type="checkbox" id="showInactive" name="showInactive" value="true" checked="@(Model.ShowInactive ? "checked" : null)" /><label class="form-check-label" for="showInactive">Show archived</label></div>
    <button class="btn btn-outline-primary" type="submit">Apply filters</button>
    <a class="btn btn-outline-secondary" asp-action="ChecklistTemplates">Clear</a>
</form>

<div class="content-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0 admin-table checklist-admin-table">
            <thead><tr><th>Order</th><th>Activity</th><th>Phase</th><th>Responsible</th><th>Due</th><th>Rules</th><th></th></tr></thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7"><div class="empty-state">No checklist activities match the selected filters.</div></td></tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr class="@(!item.IsActive ? "admin-row-inactive" : null)">
                        <td>@item.SortOrder</td>
                        <td><strong>@item.Title</strong><span class="subtext">@item.Section</span></td>
                        <td>@DisplayText.For(item.Phase)</td>
                        <td>@item.ResponsibleRole</td>
                        <td>@(item.DueOffsetDays == 0 ? "Appointment day" : item.DueOffsetDays > 0 ? $"+{item.DueOffsetDays} days" : $"{item.DueOffsetDays} days")</td>
                        <td><span class="admin-status @(item.IsActive ? "is-active" : "is-inactive")">@(item.IsActive ? "Active" : "Archived")</span><span class="subtext">@(item.IsMandatory ? "Required" : "Optional")</span></td>
                        <td class="text-end admin-row-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="EditChecklistTemplate" asp-route-id="@item.Id">Edit</a><form asp-action="ToggleChecklistTemplate" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-primary")" type="submit">@(item.IsActive ? "Archive" : "Activate")</button></form></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
