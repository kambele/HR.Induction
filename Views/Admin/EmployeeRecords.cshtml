@model EmployeeRecordAdministrationViewModel
@{
    ViewData["Title"] = "Employee induction records";
    var totalFeedbackResponses = Model.ProgrammeFeedbackResponses + Model.TrainingEvaluationResponses;
}

<section class="page-heading compact-heading">
    <a class="back-link" asp-action="Index">&larr; Back to administration</a>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">
        <div>
            <p class="eyebrow">Administration</p>
            <h1>Employee induction records</h1>
            <p class="lead-copy">Clear submitted feedback for resubmission, or permanently remove employee induction records and their associated workflow data.</p>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card"><span class="metric-label">Employee inductions</span><strong>@Model.TotalInductions</strong><span class="metric-note">All induction records</span></div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-success"><span class="metric-label">Programme feedback</span><strong>@Model.ProgrammeFeedbackResponses</strong><span class="metric-note">Employee induction responses</span></div>
    </div>
    <div class="col-md-4">
        <div class="metric-card metric-gold"><span class="metric-label">Training evaluations</span><strong>@Model.TrainingEvaluationResponses</strong><span class="metric-note">Additional feedback forms</span></div>
    </div>
</div>

<form method="get" class="content-card admin-filter-bar mb-4">
    <div class="admin-record-search">
        <label class="form-label" for="search">Search employee records</label>
        <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Employee, email, AD ID, number, department or division" />
    </div>
    <button class="btn btn-outline-primary" type="submit">Search</button>
    <a class="btn btn-outline-secondary" asp-action="EmployeeRecords">Clear</a>
</form>

<form id="employeeRecordsForm" asp-action="ClearEmployeeFeedback" method="post">
    <input type="hidden" name="ReturnSearch" value="@Model.Search" />
    <div class="content-card p-0 overflow-hidden">
        <div class="employee-record-actions">
            <div>
                <strong>Manage selected records</strong>
                <span id="employeeRecordSelectedCount">0 selected</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-danger" id="openClearFeedbackModal" type="button" data-bs-toggle="modal" data-bs-target="#clearFeedbackModal" disabled>Clear feedback</button>
                <button class="btn btn-danger" id="openDeleteInductionsModal" type="button" data-bs-toggle="modal" data-bs-target="#deleteInductionsModal" disabled>Delete inductions</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 admin-table employee-record-table">
                <thead>
                    <tr>
                        <th class="employee-record-check"><input class="form-check-input" id="selectAllEmployeeRecords" type="checkbox" aria-label="Select all employee induction records" /></th>
                        <th>Employee</th>
                        <th>Organisation</th>
                        <th>Programme</th>
                        <th>Status</th>
                        <th>Feedback responses</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7"><div class="empty-state">No employee induction records match the search.</div></td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="employee-record-check">
                                <input class="form-check-input employee-record-checkbox" type="checkbox" name="InductionCaseIds" value="@item.Id" id="employee-record-@item.Id" aria-label="Select @item.EmployeeName" />
                            </td>
                            <td>
                                <label for="employee-record-@item.Id"><strong>@item.EmployeeName</strong></label>
                                <span class="subtext">@(item.EmployeeEmail ?? "Email not recorded")</span>
                                <span class="subtext">Appointed @item.AppointmentDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td><strong>@item.Department</strong><span class="subtext">@item.Division</span></td>
                            <td>@(item.ProgrammeTitle ?? "Not assigned")</td>
                            <td><span class="status-badge status-@item.Status.ToString().ToLowerInvariant()">@DisplayText.For(item.Status)</span></td>
                            <td>
                                @if (!item.HasFeedback)
                                {
                                    <span class="admin-status is-inactive">None</span>
                                }
                                else
                                {
                                    @if (item.FeedbackSubmittedAtUtc.HasValue)
                                    {
                                        <span class="admin-status is-active">Programme feedback</span>
                                        <span class="subtext">@item.FeedbackSubmittedAtUtc.Value.ToString("dd MMM yyyy HH:mm") UTC</span>
                                    }
                                    @if (item.TrainingEvaluationCount > 0)
                                    {
                                        <span class="subtext">@item.TrainingEvaluationCount training evaluation@(item.TrainingEvaluationCount == 1 ? string.Empty : "s")</span>
                                    }
                                }
                            </td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-controller="Inductions" asp-action="Details" asp-route-id="@(item.AccessToken.ToString("N"))">Open</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="clearFeedbackModal" tabindex="-1" aria-labelledby="clearFeedbackModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content invitation-modal">
                <div class="modal-header">
                    <div><p class="eyebrow mb-1">Feedback reset</p><h2 class="modal-title fs-4" id="clearFeedbackModalTitle">Clear feedback responses?</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>This will clear programme feedback, presentation ratings and training evaluations for <strong id="clearFeedbackSelectionCount">0 selected records</strong>.</p>
                    <div class="alert alert-warning mb-0">The induction plan, checklist, attendance and sign-offs will be retained. Employees can submit feedback again.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-outline-danger" type="submit" formaction="@Url.Action("ClearEmployeeFeedback", "Admin")">Clear feedback responses</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteInductionsModal" tabindex="-1" aria-labelledby="deleteInductionsModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content invitation-modal">
                <div class="modal-header">
                    <div><p class="eyebrow mb-1 text-danger">Permanent removal</p><h2 class="modal-title fs-4" id="deleteInductionsModalTitle">Delete employee inductions?</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>This will permanently remove <strong id="deleteInductionSelectionCount">0 selected records</strong>, including checklist activity, attendance, feedback, evaluations and sign-offs.</p>
                    <div class="alert alert-danger">This action cannot be undone.</div>
                    <label class="form-label" for="deleteConfirmationText">Type <strong>DELETE</strong> to confirm</label>
                    <input class="form-control" id="deleteConfirmationText" name="ConfirmationText" autocomplete="off" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger" id="confirmDeleteInductions" type="submit" formaction="@Url.Action("DeleteEmployeeInductions", "Admin")" disabled>Delete permanently</button>
                </div>
            </div>
        </div>
    </div>
</form>

@if (totalFeedbackResponses == 0)
{
    <div class="alert alert-info mt-4 mb-0">No feedback responses are currently stored. Employee induction records can still be selected for permanent removal.</div>
}

@section Scripts {
    <script>
        (() => {
            const checkboxes = [...document.querySelectorAll('.employee-record-checkbox')];
            const selectAll = document.getElementById('selectAllEmployeeRecords');
            const selectedCount = document.getElementById('employeeRecordSelectedCount');
            const clearButton = document.getElementById('openClearFeedbackModal');
            const deleteButton = document.getElementById('openDeleteInductionsModal');
            const clearCount = document.getElementById('clearFeedbackSelectionCount');
            const deleteCount = document.getElementById('deleteInductionSelectionCount');
            const deleteText = document.getElementById('deleteConfirmationText');
            const confirmDelete = document.getElementById('confirmDeleteInductions');
            if (!selectAll || !selectedCount || !clearButton || !deleteButton || !clearCount || !deleteCount || !deleteText || !confirmDelete) return;

            const refresh = () => {
                const selected = checkboxes.filter(item => item.checked).length;
                const label = `${selected} selected`;
                selectedCount.textContent = label;
                clearCount.textContent = `${selected} selected record${selected === 1 ? '' : 's'}`;
                deleteCount.textContent = `${selected} selected record${selected === 1 ? '' : 's'}`;
                clearButton.disabled = selected === 0;
                deleteButton.disabled = selected === 0;
                selectAll.checked = checkboxes.length > 0 && selected === checkboxes.length;
                selectAll.indeterminate = selected > 0 && selected < checkboxes.length;
                confirmDelete.disabled = selected === 0 || deleteText.value.trim() !== 'DELETE';
            };

            selectAll.addEventListener('change', () => {
                checkboxes.forEach(item => item.checked = selectAll.checked);
                refresh();
            });
            checkboxes.forEach(item => item.addEventListener('change', refresh));
            deleteText.addEventListener('input', refresh);
            document.getElementById('deleteInductionsModal')?.addEventListener('hidden.bs.modal', () => {
                deleteText.value = '';
                refresh();
            });
            refresh();
        })();
    </script>
}
