@model EmployeePortalMessageViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = Model.Title;
}

<section class="employee-portal-card employee-message-card">
    <span class="employee-message-icon is-muted" aria-hidden="true">!</span>
    <h1>@Model.Title</h1>
    <p>@Model.Message</p>
    <p class="employee-close-note">Please close this window. Contact your HR Business Partner if you need a new invitation.</p>
    <button class="btn btn-outline-primary" type="button" onclick="window.close()">Close window</button>
</section>
