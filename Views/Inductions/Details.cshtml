@model InductionDetailsViewModel
@inject Namfisa.Induction.Services.IUserAccessService AccessService
@{
    ViewData["Title"] = Model.Induction.EmployeeName;
    var induction = Model.Induction;
    var currentUsername = AccessService.CurrentUsername(User);
    var locked = Model.LockChecklistWhenSignOffStarts && induction.SignOffs.Count > 0;
    var mandatoryComplete = induction.Tasks.Where(x => x.IsMandatory)
        .All(x => x.Status is InductionTaskStatus.Completed or InductionTaskStatus.NotApplicable);
    var checklistReadyForSignOff = !Model.RequireMandatoryTasksBeforeSignOff || mandatoryComplete;
    string RatingText(int? rating) => rating switch { 1 => "Poor", 2 => "Fair", 3 => "Good", 4 => "Very good", 5 => "Excellent", _ => "Not recorded" };
    string AllocationText(TimeAllocationResponse? response) => response switch { TimeAllocationResponse.Appropriate => "Appropriate", TimeAllocationResponse.TooShort => "Too short", TimeAllocationResponse.TooLong => "Too long", _ => "Not recorded" };
}

<section class="page-heading compact-heading">
    <a class="back-link" asp-action="Index">&larr; Back to inductions</a>
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-end">
        <div>
            <p class="eyebrow">Employee induction</p>
            <h1>@induction.EmployeeName</h1>
            <p class="lead-copy">@induction.Position · @induction.Department · @induction.Division</p>
            <p class="employee-ad-id">Employee AD ID: <code>@induction.EmployeeUsername</code></p>
            <p class="employee-ad-id">Employee email: <strong>@(induction.EmployeeEmail ?? "Not recorded")</strong></p>
        </div>
        <div class="induction-header-actions">
            <span class="status-badge status-large status-@induction.Status.ToString().ToLowerInvariant()">@DisplayText.For(induction.Status)</span>
            @if (Model.CanManage)
            {
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@induction.Id">Edit induction</a>
            }
            <a class="btn btn-primary" asp-action="DownloadReport" asp-route-id="@induction.Id">Download PDF report</a>
        </div>
    </div>
</section>

<section class="content-card overview-card mb-4">
    <div class="row g-4 align-items-center">
        <div class="col-lg-3">
            <span class="detail-label">Appointment date</span>
            <strong>@induction.AppointmentDate.ToString("dd MMMM yyyy")</strong>
        </div>
        <div class="col-lg-3">
            <span class="detail-label">Employee profile</span>
            <strong>@induction.Position</strong>
            <small>@induction.Gender</small>
        </div>
        <div class="col-lg-3">
            <span class="detail-label">Line manager</span>
            <strong>@induction.LineManagerName</strong>
            <small>@induction.LineManagerUsername</small>
        </div>
        <div class="col-lg-3">
            <span class="detail-label">HR business partner</span>
            <strong>@induction.HrBusinessPartnerName</strong>
            <small>@induction.HrBusinessPartnerUsername</small>
        </div>
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="detail-label mb-0">Overall progress</span>
                <strong>@Model.CompletedTaskCount of @Model.TotalTaskCount tasks · @Model.ProgressPercentage%</strong>
            </div>
            <div class="progress progress-large" role="progressbar" aria-label="Overall induction progress" aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @Model.ProgressPercentage%"></div>
            </div>
        </div>
    </div>
</section>

@if (Model.CanManage)
{
    <section class="content-card invitation-card mb-4">
        <div>
            <p class="eyebrow">Employee invitation</p>
            <h2>Send induction invitation</h2>
            <p class="mb-0 text-muted">The system sends a branded invitation directly to the employee email recorded on this plan.</p>
        </div>
        <div class="invitation-card-action">
            <strong>@(induction.EmployeeEmail ?? "Email address not recorded")</strong>
            @if (induction.InvitationSentAtUtc.HasValue)
            {
                <small>Last sent @induction.InvitationSentAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") by @induction.InvitationSentBy</small>
            }
            else
            {
                <small>No invitation has been sent.</small>
            }
            @if (!Model.SmtpConfigured)
            {
                <span class="text-warning-emphasis">SMTP email delivery is not configured.</span>
            }
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button class="btn btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#updateEmployeeEmailModal">Update email</button>
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#sendInvitationModal"
                        disabled="@(string.IsNullOrWhiteSpace(induction.EmployeeEmail) || !Model.SmtpConfigured ? "disabled" : null)">
                    @(induction.InvitationSentAtUtc.HasValue ? "Send again" : "Send invitation")
                </button>
            </div>
        </div>
    </section>

    <div class="modal fade" id="sendInvitationModal" tabindex="-1" aria-labelledby="sendInvitationTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content invitation-modal">
                <form asp-action="SendInvitations" method="post">
                    <input type="hidden" name="InductionCaseIds" value="@induction.Id" />
                    <input type="hidden" name="ReturnToInductionId" value="@induction.Id" />
                    <div class="modal-header">
                        <div>
                            <p class="eyebrow mb-1">Confirm invitation</p>
                            <h2 class="modal-title fs-4" id="sendInvitationTitle">Send to @induction.EmployeeName?</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">A personalised induction invitation and secure plan link will be sent directly from the system to:</p>
                        <div class="invitation-recipient">@induction.EmployeeEmail</div>
                        @if (induction.InvitationSentAtUtc.HasValue)
                        {
                            <div class="alert alert-info mt-3 mb-0">This employee was invited previously. Sending again will record a new delivery time.</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Send invitation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="updateEmployeeEmailModal" tabindex="-1" aria-labelledby="updateEmployeeEmailTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content invitation-modal">
                <form asp-action="UpdateEmployeeEmail" method="post">
                    <input type="hidden" name="InductionCaseId" value="@induction.Id" />
                    <div class="modal-header">
                        <div>
                            <p class="eyebrow mb-1">Employee contact</p>
                            <h2 class="modal-title fs-4" id="updateEmployeeEmailTitle">Update email address</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="updatedEmployeeEmail">Employee email address</label>
                        <input class="form-control" id="updatedEmployeeEmail" name="EmployeeEmail" type="email" value="@induction.EmployeeEmail" autocomplete="email" required placeholder="employee@namfisa.com.na" />
                        <div class="form-text">Future invitations will be sent to this address. Previous delivery history remains in the audit record.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save email</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (locked)
{
    <div class="alert alert-info">Checklist changes are locked because the sign-off process has started.</div>
}

<section class="mb-5">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Plan and conduct</p>
            <h2>Induction checklist</h2>
        </div>
        <span>@Model.CompletedTaskCount / @Model.TotalTaskCount complete</span>
    </div>

    <div class="phase-stack">
        @foreach (var phaseGroup in induction.Tasks.OrderBy(x => x.SortOrder).GroupBy(x => x.Phase))
        {
            var phaseCompleted = phaseGroup.Count(x => x.Status != InductionTaskStatus.NotStarted);
            <article class="content-card phase-card">
                <div class="phase-header">
                    <div>
                        <h3>@DisplayText.For(phaseGroup.Key)</h3>
                        <p>@phaseCompleted of @phaseGroup.Count() items complete</p>
                    </div>
                    <span class="phase-count">@phaseCompleted/@phaseGroup.Count()</span>
                </div>
                <div class="table-responsive">
                    <table class="table task-table align-middle mb-0">
                        <thead>
                            <tr><th>Activity</th><th>Responsible</th><th>Due</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var task in phaseGroup)
                        {
                            var overdue = task.Status == InductionTaskStatus.NotStarted && task.DueDate.Date < DateTime.Today;
                            var canComplete = Model.CanManage || string.Equals(task.AssignedToUsername, currentUsername, StringComparison.OrdinalIgnoreCase);
                            <tr class="@(overdue ? "task-overdue" : null)">
                                <td>
                                    <strong>@task.Title</strong>
                                    <span class="subtext">@task.Section @(task.IsMandatory ? "· Required" : "· Optional")</span>
                                    @if (!string.IsNullOrWhiteSpace(task.Notes))
                                    {
                                        <span class="task-note">@task.Notes</span>
                                    }
                                </td>
                                <td>@task.ResponsibleRole<span class="subtext">@(task.AssignedToUsername ?? "Assign through HR")</span></td>
                                <td><span class="@(overdue ? "due-overdue" : null)">@task.DueDate.ToString("dd MMM yyyy")</span></td>
                                <td><span class="task-status task-status-@task.Status.ToString().ToLowerInvariant()">@DisplayText.For(task.Status)</span></td>
                                <td class="text-end">
                                    @if (canComplete && !locked)
                                    {
                                        <details class="task-update">
                                            <summary class="btn btn-sm btn-outline-secondary">Update</summary>
                                            <form asp-action="UpdateTask" method="post" class="task-update-panel text-start">
                                                <input type="hidden" name="taskId" value="@task.Id" />
                                                <label class="form-label" for="status-@task.Id">Status</label>
                                                <select class="form-select form-select-sm" id="status-@task.Id" name="status">
                                                    @foreach (var status in Enum.GetValues<InductionTaskStatus>())
                                                    {
                                                        <option value="@status" selected="@(task.Status == status ? "selected" : null)">@DisplayText.For(status)</option>
                                                    }
                                                </select>
                                                <label class="form-label mt-2" for="notes-@task.Id">Notes</label>
                                                <textarea class="form-control form-control-sm" id="notes-@task.Id" name="notes" rows="2">@task.Notes</textarea>
                                                @if (Model.CanManage)
                                                {
                                                    <label class="form-label mt-2" for="assignee-@task.Id">Assigned Windows username</label>
                                                    <input class="form-control form-control-sm" id="assignee-@task.Id" name="assignedToUsername" value="@task.AssignedToUsername" placeholder="DOMAIN\username" />
                                                    <label class="form-label mt-2" for="due-@task.Id">Due date</label>
                                                    <input class="form-control form-control-sm" id="due-@task.Id" name="dueDate" type="date" value="@task.DueDate.ToString("yyyy-MM-dd")" />
                                                }
                                                <button class="btn btn-primary btn-sm w-100 mt-2" type="submit">Save update</button>
                                            </form>
                                        </details>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </article>
        }
    </div>
</section>

<section class="mb-5">
    <div class="section-heading">
        <div><p class="eyebrow">Corporate programme</p><h2>Divisional presentation schedule</h2></div>
        @if (Model.CanManage && induction.InductionProgramme is not null)
        {
            <a class="btn btn-sm btn-outline-primary" asp-controller="InductionProgrammes" asp-action="Details" asp-route-id="@induction.InductionProgramme.Id">Manage programme</a>
        }
    </div>
    @if (induction.InductionProgramme is null)
    {
        <div class="content-card empty-state">@(Model.CanManage ? "Assign an induction programme from Edit induction." : "HR will publish the divisional presentation schedule when it is ready.")</div>
    }
    else
    {
        var programme = induction.InductionProgramme;
        <div class="content-card p-0 overflow-hidden">
            <div class="programme-summary-bar">
                <div><strong>@programme.Title</strong><span>@programme.ProgrammeDate.ToString("dddd, dd MMMM yyyy")</span></div>
                <div><strong>@(programme.Venue ?? "Venue to be confirmed")</strong><span>@programme.Status</span></div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 programme-schedule-table">
                    <thead><tr><th>Time slot</th><th>Division</th><th>Presenter</th></tr></thead>
                    <tbody>
                    @foreach (var session in programme.Sessions.OrderBy(x => x.SortOrder))
                    {
                        <tr><td><strong>@session.StartTime.ToString("hh\\:mm")-@session.EndTime.ToString("hh\\:mm")</strong></td><td>@session.Division</td><td>@session.PresenterName</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<section class="mb-5">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Employee interaction</p>
            <h2>Feedback and training</h2>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="content-card h-100">
                <div class="card-heading">
                    <div>
                        <h3>Corporate induction programme feedback</h3>
                        <p>Rate every divisional presentation and the overall programme.</p>
                    </div>
                </div>
                @if (induction.EmployeeFeedback is not null)
                {
                    @if (induction.EmployeeFeedback.OverallProgrammeRating.HasValue)
                    {
                        <div class="submitted-ratings mb-4">
                            @foreach (var rating in induction.EmployeeFeedback.PresentationRatings.OrderBy(x => x.InductionProgrammeSession.SortOrder))
                            {
                                <div><span>@rating.InductionProgrammeSession.Division<small>@rating.InductionProgrammeSession.PresenterName</small></span><strong>@rating.Rating/5</strong></div>
                            }
                        </div>
                        <dl class="feedback-summary">
                            <div><dt>Understanding of the organisation</dt><dd>@RatingText(induction.EmployeeFeedback.ProgrammeUnderstandingRating)</dd></div>
                            <div><dt>Presentation time allocation</dt><dd>@AllocationText(induction.EmployeeFeedback.TimeAllocationResponse)</dd></div>
                            <div><dt>Overall programme</dt><dd>@RatingText(induction.EmployeeFeedback.OverallProgrammeRating)</dd></div>
                            <div><dt>Most valuable aspect</dt><dd>@induction.EmployeeFeedback.MostValuableAspect</dd></div>
                            <div><dt>Recommended improvements</dt><dd>@induction.EmployeeFeedback.ImprovementRecommendations</dd></div>
                        </dl>
                    }
                    else
                    {
                        <dl class="feedback-summary">
                            <div><dt>Understands responsibilities</dt><dd>@(induction.EmployeeFeedback.UnderstandsResponsibilities ? "Yes" : "No")</dd></div>
                            <div><dt>Aware of development opportunities</dt><dd>@(induction.EmployeeFeedback.AwareOfDevelopmentOpportunities ? "Yes" : "No")</dd></div>
                            <div><dt>Missing from induction</dt><dd>@(induction.EmployeeFeedback.MissingFromInduction ?? "Nothing reported")</dd></div>
                            <div><dt>Additional comments</dt><dd>@(induction.EmployeeFeedback.AdditionalComments ?? "None")</dd></div>
                        </dl>
                    }
                    <p class="audit-line">Submitted by @induction.EmployeeFeedback.SubmittedBy on @induction.EmployeeFeedback.SubmittedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</p>
                }
                else if (Model.CanSubmitFeedback)
                {
                    <div class="empty-state">
                        <h3>Feedback form is ready</h3>
                        <p>Rate every divisional presentation and the overall programme on the dedicated employee form.</p>
                        <a class="btn btn-primary" asp-action="Feedback" asp-route-id="@induction.Id">Open feedback form</a>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        @if (induction.InductionProgramme is null)
                        {
                            <p>An induction programme must be assigned before feedback can be submitted.</p>
                        }
                        else if (induction.ProgrammeAttendance?.Status != ProgrammeAttendanceStatus.Present && AccessService.CanSelfConfirmAttendance(User, induction))
                        {
                            <p>Confirm attendance before completing the programme feedback form.</p>
                            <a class="btn btn-primary" asp-controller="Attendance" asp-action="Confirm" asp-route-id="@induction.Id">Confirm attendance</a>
                        }
                        else
                        {
                            <p>Waiting for the employee to confirm attendance and submit feedback.</p>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-xl-4">
            <div class="content-card h-100">
                <div class="card-heading">
                    <div>
                        <h3>Training evaluations</h3>
                        <p>Feedback for courses completed during induction.</p>
                    </div>
                    @if (AccessService.CanSubmitFeedback(User, induction))
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="TrainingEvaluations" asp-action="Create" asp-route-inductionCaseId="@induction.Id">Add evaluation</a>
                    }
                </div>
                @if (induction.TrainingEvaluations.Count == 0)
                {
                    <div class="empty-state">No training evaluations have been submitted.</div>
                }
                else
                {
                    <div class="evaluation-list">
                        @foreach (var evaluation in induction.TrainingEvaluations.OrderByDescending(x => x.CourseDate))
                        {
                            <a asp-controller="TrainingEvaluations" asp-action="Details" asp-route-id="@evaluation.Id">
                                <span>
                                    <strong>@evaluation.CourseTitle</strong>
                                    <small>@evaluation.CourseProvider · @evaluation.CourseDate.ToString("dd MMM yyyy")</small>
                                </span>
                                <span class="evaluation-score">@evaluation.OverallImpression/4</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="mb-4">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Confirm and close</p>
            <h2>Sequential sign-off</h2>
        </div>
        @if (!checklistReadyForSignOff)
        {
            <span>Complete all required tasks first</span>
        }
    </div>

    <div class="row g-3">
        @foreach (var role in Enum.GetValues<SignOffRole>())
        {
            var signOff = induction.SignOffs.SingleOrDefault(x => x.Role == role);
            var expectedSigner = role switch
            {
                SignOffRole.Employee => induction.EmployeeUsername,
                SignOffRole.LineManager => induction.LineManagerUsername,
                SignOffRole.HrBusinessPartner => induction.HrBusinessPartnerUsername,
                _ => string.Empty
            };
            var canSign = role switch
            {
                SignOffRole.Employee => Model.CanSignEmployee,
                SignOffRole.LineManager => Model.CanSignLineManager,
                SignOffRole.HrBusinessPartner => Model.CanSignHrBusinessPartner,
                _ => false
            };
            <div class="col-lg-4">
                <div class="content-card signoff-card h-100 @(signOff is not null ? "signoff-complete" : null)">
                    <div class="signoff-number">@(Array.IndexOf(Enum.GetValues<SignOffRole>(), role) + 1)</div>
                    <h3>@DisplayText.For(role)</h3>
                    <div class="signoff-identity"><span>Assigned AD ID</span><code>@expectedSigner</code></div>
                    @if (signOff is not null)
                    {
                        <p>@signOff.Acknowledgement</p>
                        <strong>@signOff.SignedBy</strong>
                        <span>@signOff.SignedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</span>
                        @if (!string.IsNullOrWhiteSpace(signOff.SignedBySid))
                        {
                            <span>AD SID: @signOff.SignedBySid</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(signOff.AuthenticationType))
                        {
                            <span>Authentication: @signOff.AuthenticationType</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(signOff.Comments))
                        {
                            <span class="task-note">@signOff.Comments</span>
                        }
                    }
                    else if (canSign)
                    {
                        <form asp-action="SignOff" method="post">
                            <input type="hidden" name="InductionCaseId" value="@induction.Id" />
                            <input type="hidden" name="Role" value="@role" />
                            <label class="form-label" for="comments-@role">Optional comments</label>
                            <textarea class="form-control mb-3" id="comments-@role" name="Comments" rows="2"></textarea>
                            <button class="btn btn-primary w-100" type="submit" disabled="@(!checklistReadyForSignOff ? "disabled" : null)">Confirm sign-off</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Waiting for the authorised person.</p>
                    }
                </div>
            </div>
        }
    </div>
</section>
